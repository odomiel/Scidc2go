    <!-- Über -->
    <string name="about_text" tools:ignore="TypographyFractions">Chess databases on the go: reads Scid 3/4/5, Scidb and PGN (also Scidb archives .scv and PGN as .gz or .zip), writes Scid 5.</string>
    <string name="about_license">Free software under the GNU General Public License, version 3 or later. No warranty. Source code and license text come with the project.</string>
    <string name="about_components">Included free components:</string>
    <string name="about_pieces">• Chess pieces “cburnett” by Colin M.L. Burnett – GPLv2+</string>
    <string name="about_openings">• Opening names: lichess-org/chess-openings – CC0</string>
    <string name="about_formats">• Database formats based on the source code of Scid (GPL) and Scidb (GPL)</string>

